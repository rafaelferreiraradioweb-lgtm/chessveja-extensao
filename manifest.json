{
  "manifest_version": 3,
  "name": "Chessveja IA",
  "version": "1.5",
  "description": "Análise mestre de xadrez com Inteligência Artificial.",
  "permissions": ["activeTab", "scripting", "identity", "storage"],
  "oauth2": {
    "client_id": "165782355017-ic998rpi5ufpu3pcuscol7ce0rf9ig8t.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "openid"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
