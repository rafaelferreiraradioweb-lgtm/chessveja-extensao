{
  "manifest_version": 3,
  "name": "Diagnóstico do Chessveja",
  "version": "1.5",
  "description": "Análise de partidas Chessveja na lateral do Lichess.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://lichess.org/*"],
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
