{
  "manifest_version": 3,
  "name": "Chessveja IA",
  "version": "1.0",
  "description": "Análise mestre de xadrez com IA",
  "permissions": [
    "activeTab",
    "scripting",
    "identity",
    "storage"
  ],
  "oauth2": {
    "client_id": "165782355017-8il61oihum1p9r3cnamue60orh67e959.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
