{
  "manifest_version": 3,
  "name": "Chessveja IA",
  "version": "1.0",
  "description": "Análise mestre de xadrez com IA",
  "permissions": [
    "activeTab",
    "scripting",
    "identity",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
