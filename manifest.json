{
  "manifest_version": 3,
  "name": "Analisador Chessveja AI para Lichess",
  "version": "1.0",
  "description": "Analisador com IA nível GM.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Analisador"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
