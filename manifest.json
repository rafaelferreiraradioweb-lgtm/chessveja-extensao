{
  "manifest_version": 3,
  "name": "Chessveja IA - Analisador Lichess",
  "version": "2.0",
  "description": "Análise mestre de xadrez com IA direto no Lichess.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://lichess.org/*", 
    "https://chessveja-site.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content.js"]
    }
  ]
}
